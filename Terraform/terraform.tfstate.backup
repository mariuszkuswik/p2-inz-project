          "attributes": {
            "filename": null,
            "id": "784bb70cc983008328a8650214b58e64cde75574ad892efe7bb48078bf376921",
            "rendered": "#cloud-config\nusers:\n  - cloud-user\n  - name: ans_mariusz\n    sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]\n    groups: wheel,adm,systemd-journal\n    ssh_pwauth: True\n    ssh_authorized_keys:\n      - ssh-rsa  mariusz@localhost.localdomain\nchpasswd:\n  list: |\n    root:password\n    cloud-user:mypassword\n    ans_mariusz:mypassword\n  expire: False\nruncmd:\n  ### Network\n  - /usr/bin/nmcli connection modify \"System eth0\" ipv4.method manual ipv4.address 192.168.1.10/24 ipv4.gateway 192.168.1.1 ipv4.dns \"8.8.8.8 8.8.4.4\"\n  - /usr/bin/nmcli connection down \"System eth0\"\n  - /usr/bin/nmcli connection up \"System eth0\"\n  ### \n  ### Mounts\n  ## Dirs\n  - /usr/bin/mkdir /mnt/mounts\n  ## Fstab\n  - /usr/bin/echo \"/dev/sr0 /mnt/mounts iso9660 loop 0 0\" \u003e\u003e /etc/fstab\n  ## Temp mount\n  - /usr/bin/mount -a\n  ### Repos\n  # Copy all the repos configuration files to the yum.repos.d\n  - /usr/bin/cp /mnt/mounts/Repos/* /etc/yum.repos.d/\n  ### SSH \n  - /usr/bin/sed -i \"s/PasswordAuthentication no/PasswordAuthentication yes/g\" /etc/ssh/sshd_config\n  - /usr/bin/systemctl restart sshd\n  ### Ansible \n  ### Installation\n  - /usr/bin/dnf install ansible-core -y\n  # Ansible-galaxy \n  - /usr/bin/ansible-galaxy collection install community.general -p /home/ans_mariusz/.ansible/collections\n  - /usr/bin/ansible-galaxy collection install ansible.posix -p /home/ans_mariusz/.ansible/collections\n  - /usr/bin/ansible-galaxy collection install community.docker -p /home/ans_mariusz/.ansible/collections\n  - /usr/bin/python3 -m ensurepip --upgrade\n  - /usr/bin/python3 -m pip install docker\n  - /usr/bin/chown -R ans_mariusz:ans_mariusz /home/ans_mariusz/.ansible\n\n  ### Hostname\n  - nmcli general hostname control-plane \n  # Ansible-playbook \n  - /usr/bin/ansible-playbook /mnt/ansible/main.yml -u ans_mariusz \u003e\u003e /home/ans_mariusz/ansible.log\n",
            "template": "#cloud-config\nusers:\n  - cloud-user\n  - name: ans_mariusz\n    sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]\n    groups: wheel,adm,systemd-journal\n    ssh_pwauth: True\n    ssh_authorized_keys:\n      - ssh-rsa  mariusz@localhost.localdomain\nchpasswd:\n  list: |\n    root:password\n    cloud-user:mypassword\n    ans_mariusz:mypassword\n  expire: False\nruncmd:\n  ### Network\n  - /usr/bin/nmcli connection modify \"System eth0\" ipv4.method manual ipv4.address 192.168.1.10/24 ipv4.gateway 192.168.1.1 ipv4.dns \"8.8.8.8 8.8.4.4\"\n  - /usr/bin/nmcli connection down \"System eth0\"\n  - /usr/bin/nmcli connection up \"System eth0\"\n  ### \n  ### Mounts\n  ## Dirs\n  - /usr/bin/mkdir /mnt/mounts\n  ## Fstab\n  - /usr/bin/echo \"/dev/sr0 /mnt/mounts iso9660 loop 0 0\" \u003e\u003e /etc/fstab\n  ## Temp mount\n  - /usr/bin/mount -a\n  ### Repos\n  # Copy all the repos configuration files to the yum.repos.d\n  - /usr/bin/cp /mnt/mounts/Repos/* /etc/yum.repos.d/\n  ### SSH \n  - /usr/bin/sed -i \"s/PasswordAuthentication no/PasswordAuthentication yes/g\" /etc/ssh/sshd_config\n  - /usr/bin/systemctl restart sshd\n  ### Ansible \n  ### Installation\n  - /usr/bin/dnf install ansible-core -y\n  # Ansible-galaxy \n  - /usr/bin/ansible-galaxy collection install community.general -p /home/ans_mariusz/.ansible/collections\n  - /usr/bin/ansible-galaxy collection install ansible.posix -p /home/ans_mariusz/.ansible/collections\n  - /usr/bin/ansible-galaxy collection install community.docker -p /home/ans_mariusz/.ansible/collections\n  - /usr/bin/python3 -m ensurepip --upgrade\n  - /usr/bin/python3 -m pip install docker\n  - /usr/bin/chown -R ans_mariusz:ans_mariusz /home/ans_mariusz/.ansible\n\n  ### Hostname\n  - nmcli general hostname control-plane \n  # Ansible-playbook \n  - /usr/bin/ansible-playbook /mnt/ansible/main.yml -u ans_mariusz \u003e\u003e /home/ans_mariusz/ansible.log\n",
